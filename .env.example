HARDATLAS_ENVIRONMENT=development
HARDATLAS_DATA_VERSION=atlas-2026.07.29
HARDATLAS_SCHEMA_VERSION=schema-2.2.0
HARDATLAS_POLICY_VERSION=policy-1.0.0
HARDATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_HARDATLAS_WEB_URL=http://127.0.0.1:3000
VITE_HARDATLAS_API_URL=http://127.0.0.1:8000
VITE_HARDATLAS_ENABLE_HARDWARE_EXTENSION=false
HARDATLAS_ALLOW_FIXTURE_FALLBACK=false
HARDATLAS_DATABASE_URL=postgresql+psycopg://hardatlas:hardatlas@localhost:5432/hardatlas
HARDATLAS_AUTO_CREATE_SCHEMA=true
HARDATLAS_SEARCH_BACKEND=opensearch
HARDATLAS_OPENSEARCH_URL=http://localhost:9200
HARDATLAS_OPENSEARCH_INDEX_ALIAS=atlas-knowledge-read
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hardatlas-local
S3_ACCESS_KEY=hardatlas
S3_SECRET_KEY=hardatlas-local-only
S3_REGION=us-east-1
HARDATLAS_AUTH_MODE=development
HARDATLAS_SEED_FIXTURE_CONTENT=true
HARDATLAS_OIDC_ISSUER=http://localhost:8080/realms/hardatlas
HARDATLAS_OIDC_AUDIENCE=hardatlas-api
HARDATLAS_OIDC_CLIENT_ID=hardatlas-admin
HARDATLAS_WEB_OIDC_CLIENT_ID=hardatlas-web
HARDATLAS_OIDC_JWKS_URL=http://localhost:8080/realms/hardatlas/protocol/openid-connect/certs
HARDATLAS_OIDC_ALGORITHMS=RS256
HARDATLAS_OIDC_ROLES_CLAIM=roles
HARDATLAS_OIDC_WORKSPACE_CLAIM=workspace_id
HARDATLAS_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:3000,http://localhost:3001,https://tauri.localhost,tauri://localhost
HARDATLAS_ENABLE_HARDWARE_FIXTURE_EXTENSION=true
HARDATLAS_AGENT_PACK_PATHS=agent-packs/core
# Optional model Agents use only this explicit proxy. Leave blank for deterministic mode.
HARDATLAS_MODEL_GATEWAY_URL=
HARDATLAS_MODEL_GATEWAY_MODEL=
HARDATLAS_MODEL_GATEWAY_ENDPOINT_PATH=/v1/responses
HARDATLAS_MODEL_GATEWAY_ID=configured-proxy
HARDATLAS_MODEL_GATEWAY_TIMEOUT_SECONDS=60
HARDATLAS_MODEL_ALLOW_DIRECT_PROVIDER=false
HARDATLAS_PUBLIC_ANSWER_MODEL_ENABLED=false
# Inject HARDATLAS_MODEL_GATEWAY_API_KEY through the local shell or secret manager.
HARDATLAS_PARSER_PATHS=parser-packs/core
HARDATLAS_DOMAIN_PACK_PATHS=domain-packs/core,domain-packs/animals,domain-packs/plants,domain-packs/electronics,domain-packs/oceanography
HARDATLAS_REDIS_URL=redis://localhost:6379/0
HARDATLAS_OUTBOX_POLL_SECONDS=2
HARDATLAS_OUTBOX_BATCH_SIZE=100
HARDATLAS_AUTO_RELEASE_ENABLED=true
HARDATLAS_AUTO_RELEASE_BATCH_SIZE=50
HARDATLAS_AUTO_ROLLBACK_ENABLED=true
HARDATLAS_SOURCE_SCHEDULER_SECONDS=30
HARDATLAS_QUALITY_SCAN_SECONDS=3600
