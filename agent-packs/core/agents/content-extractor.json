{
  "id": "agent-content-extractor",
  "version": "1.3.0",
  "name": "结构化内容抽取",
  "role": "extraction",
  "handlerKey": "content-extraction",
  "description": "依据实体 Schema 从不可变来源快照中产生字段候选，不直接写入知识库。",
  "capabilities": ["schema-read", "snapshot-read", "field-candidate"],
  "allowedProposalTypes": ["content", "relation"],
  "maximumRisk": "medium",
  "modelPolicy": "optional-model",
  "inputContract": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "minLength": 1 },
      "fieldPath": { "type": "string", "pattern": "^/" },
      "proposedValue": {},
      "citationId": { "type": "string", "minLength": 1 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "sourceExcerpt": { "type": ["string", "null"], "maxLength": 50000 },
      "modelProcessingAllowed": { "type": "boolean" },
      "currentRevisionId": { "type": "string", "minLength": 1 },
      "currentValuePresent": { "type": "boolean" },
      "currentValue": {},
      "citationAlreadyPresent": { "type": "boolean" },
      "citation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceTitle": { "type": "string", "minLength": 1 },
          "sourceTier": {
            "enum": ["primary", "authoritative", "secondary", "community"]
          },
          "retrievedAt": { "type": "string", "format": "date-time" },
          "locator": { "type": "string", "minLength": 1 },
          "quoteHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "sourceId",
          "sourceTitle",
          "sourceTier",
          "retrievedAt",
          "locator",
          "quoteHash"
        ]
      }
    },
    "required": [
      "label",
      "fieldPath",
      "proposedValue",
      "citationId",
      "confidence",
      "currentRevisionId",
      "currentValuePresent",
      "citationAlreadyPresent"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "citationAlreadyPresent": { "const": false }
          },
          "required": ["citationAlreadyPresent"]
        },
        "then": { "required": ["citation"] }
      }
    ]
  },
  "outputContract": {
    "type": "object",
    "properties": {
      "label": { "type": "string", "minLength": 1 },
      "fieldPath": { "type": "string", "pattern": "^/" },
      "proposedValue": {},
      "citationId": { "type": "string", "minLength": 1 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "executionMode": { "enum": ["deterministic", "model"] }
    },
    "required": [
      "label",
      "fieldPath",
      "proposedValue",
      "citationId",
      "confidence"
    ]
  }
}
